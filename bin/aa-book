#!/bin/bash
# aa-book: Anna's Archive → NAS book pipeline
# Usage: aa-book <command> [args...]
# Requires: agent-secrets (annas_archive_key), agent-browser, curl, python3

set -e

COOKIE_FILE="${HOME}/.config/annas-archive/cookies.txt"
SESSION_FILE="${HOME}/.config/annas-archive/aa-session.json"
CONFIG_DIR="${HOME}/.config/annas-archive"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Self-healing mirror discovery
# Primary source: Wikipedia (AA's own recommendation for current domains)
# Fallback: cached mirrors file + hardcoded seeds
MIRRORS_CACHE="${CONFIG_DIR}/mirrors.txt"
MIRRORS_CACHE_TTL=86400  # refresh daily

discover_mirrors() {
  # Scrape current TLDs from Wikipedia + Reddit sidebar
  local wiki_mirrors
  wiki_mirrors=$(curl -sL --connect-timeout 5 "https://en.wikipedia.org/wiki/Anna%27s_Archive" 2>/dev/null \
    | grep -oE 'annas-archive\.[a-z]{2,3}' | sort -u | head -10)
  # Reddit sidebar often has latest domains
  local reddit_mirrors
  reddit_mirrors=$(curl -sL --connect-timeout 5 -H "User-Agent: aa-book/1.0" \
    "https://old.reddit.com/r/Annas_Archive" 2>/dev/null \
    | grep -oE 'annas-archive\.[a-z]{2,3}' | sort -u | head -10)
  wiki_mirrors=$(echo -e "$wiki_mirrors\n$reddit_mirrors" | sort -u)
  {
    for m in $wiki_mirrors; do echo "https://$m"; done
    # Hardcoded seeds as last resort
    echo "https://annas-archive.gl"
    echo "https://annas-archive.li"
    echo "https://welib.org"
  } | sort -u | grep -v '^$'
}

# Classify a mirror by what curl actually gets back from a search, not by
# the status code of GET /. Verified 2026-09-10: annas-archive.li answered
# 200 as a parked "domain may be for sale" page, and the .gd/.gl/.pk mirrors
# answered 200 on / but 302'd every /search into a DDoS-Guard check page.
#   ok       search returns md5 links; curl search works
#   shielded bot check page; curl search is blank, browser-driven download still works
#   parked   domain squatter page
#   dead     no answer / no HTML
probe_mirror() {
  local mirror="$1" body code
  body=$(curl -sL --connect-timeout 4 -m 12 -w '\n__CODE__%{http_code}' "${mirror}/search?q=test" 2>/dev/null) || body=""
  code="${body##*__CODE__}"
  body="${body%__CODE__*}"
  if [[ -z "$body" || "$code" == "000" ]]; then
    echo dead
  elif echo "$body" | grep -qiE 'domain may be for sale|domain is for sale|buy this domain'; then
    echo parked
  elif echo "$body" | grep -q '/md5/'; then
    echo ok
  elif echo "$body" | grep -qiE 'ddos-guard|checking your browser|just a moment|cf-challenge|__cf_chl'; then
    echo shielded
  else
    echo "http-${code}"
  fi
}

ACTIVE_MIRROR_CACHE="${CONFIG_DIR}/active-mirror.txt"
ACTIVE_MIRROR_TTL=3600  # re-probe hourly; 'aa-book mirrors' forces it

resolve_base_url() {
  local mirrors
  # Refresh cache if stale or missing
  if [[ ! -f "$MIRRORS_CACHE" ]] || [[ $(($(date +%s) - $(stat -f%m "$MIRRORS_CACHE" 2>/dev/null || echo 0))) -gt $MIRRORS_CACHE_TTL ]]; then
    mirrors=$(discover_mirrors)
    [[ -n "$mirrors" ]] && echo "$mirrors" > "$MIRRORS_CACHE"
  fi
  # Reuse the last good pick for an hour so every command doesn't re-probe
  if [[ -z "$AA_FORCE_PROBE" && -f "$ACTIVE_MIRROR_CACHE" ]] && \
     [[ $(($(date +%s) - $(stat -f%m "$ACTIVE_MIRROR_CACHE" 2>/dev/null || echo 0))) -lt $ACTIVE_MIRROR_TTL ]]; then
    local cached
    cached=$(cat "$ACTIVE_MIRROR_CACHE" 2>/dev/null)
    [[ -n "$cached" ]] && { echo "$cached"; return 0; }
  fi
  # Read from cache (or seeds if cache empty)
  mirrors=$(cat "$MIRRORS_CACHE" 2>/dev/null || echo "https://annas-archive.gl")

  # Prefer a mirror whose search actually works for curl. A shielded mirror
  # is second best: search is blank but the browser-driven download path
  # still resolves fast-partner URLs through it. Never pick parked or dead.
  local mirror status shielded=""
  for mirror in $mirrors; do
    status=$(probe_mirror "$mirror")
    if [[ "$status" == "ok" ]]; then
      echo "$mirror" > "$ACTIVE_MIRROR_CACHE"
      echo "$mirror"
      return 0
    elif [[ "$status" == "shielded" && -z "$shielded" ]]; then
      shielded="$mirror"
    fi
  done
  if [[ -n "$shielded" ]]; then
    echo "$shielded" > "$ACTIVE_MIRROR_CACHE"
    echo "$shielded"
    return 0
  fi
  return 1
}

read_env_file_value() {
    local key="$1" env_file="${JOELCLAW_SYSTEM_BUS_ENV:-${HOME}/.config/system-bus.env}"
    [[ -f "$env_file" ]] || return 1

    local value
    value=$(awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$env_file")
    value="${value%$'\r'}"
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
        value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
        value="${value:1:${#value}-2}"
    fi
    [[ -n "$value" ]] || return 1
    printf '%s\n' "$value"
}

BASE_URL=$(resolve_base_url) || { error "All Anna's Archive mirrors unreachable. Run 'aa-book mirrors' to diagnose."; exit 1; }
LOCAL_STAGING="/tmp/aa-book"
NAS_HOST="${JOELCLAW_NAS_HOST:-$(read_env_file_value JOELCLAW_NAS_HOST || true)}"
NAS_BOOKS_DIR="${JOELCLAW_NAS_BOOKS_DIR:-$(read_env_file_value JOELCLAW_NAS_BOOKS_DIR || true)}"
PROGRESS_LOG="/tmp/aa-book-progress.log"

mkdir -p "$CONFIG_DIR" "$LOCAL_STAGING"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log() { echo -e "${GREEN}[$(date +%H:%M:%S)]${NC} $1" | tee -a "$PROGRESS_LOG"; }
warn() { echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} $1" | tee -a "$PROGRESS_LOG"; }
error() { echo -e "${RED}[$(date +%H:%M:%S)]${NC} $1" | tee -a "$PROGRESS_LOG"; }
status() { echo -e "${CYAN}[STATUS]${NC} $1" | tee -a "$PROGRESS_LOG"; }

# --- Auth ---
# Browser-based login (required for fast downloads)
browser_login() {
    local secret
    if command -v secrets &> /dev/null; then
        secret=$(secrets lease annas_archive_key --ttl 15m --raw 2>/dev/null)
    fi
    [[ -z "$secret" ]] && { error "Failed to lease annas_archive_key from agent-secrets"; return 1; }

    log "Logging in via browser..."
    agent-browser open "${BASE_URL}/account/" 2>/dev/null
    agent-browser wait --load networkidle 2>/dev/null

    # Fill secret key and submit. Support both legacy "@e123" and current "ref=e123" snapshot formats.
    local snapshot
    snapshot="$(agent-browser snapshot -i 2>/dev/null || true)"
    echo "$snapshot" | grep -q 'Secret key' || { error "Login page not found"; return 1; }

    local key_ref
    key_ref="$(echo "$snapshot" | grep 'Secret key' | grep -m1 -oE 'ref=e[0-9]+' | cut -d= -f2)"
    if [[ -z "$key_ref" ]]; then
        key_ref="$(echo "$snapshot" | grep 'Secret key' | grep -m1 -oE '@e[0-9]+' | sed 's/@//')"
    fi

    local btn_ref
    btn_ref="$(echo "$snapshot" | grep 'button \"Log in\"' | grep -m1 -oE 'ref=e[0-9]+' | cut -d= -f2)"
    if [[ -z "$btn_ref" ]]; then
        btn_ref="$(echo "$snapshot" | grep 'button \"Log in\"' | grep -m1 -oE '@e[0-9]+' | sed 's/@//')"
    fi

    [[ -z "$key_ref" || -z "$btn_ref" ]] && { error "Could not resolve login form references"; return 1; }

    agent-browser fill "$key_ref" "$secret" 2>/dev/null
    agent-browser click "$btn_ref" 2>/dev/null
    agent-browser wait --load networkidle 2>/dev/null

    # Save session for reuse
    agent-browser state save "$SESSION_FILE" 2>/dev/null
    log "Login successful, session saved"
}

# Restore browser session or login fresh
ensure_browser_auth() {
    if [[ -f "$SESSION_FILE" ]]; then
        # state load fails when a browser is already running
        agent-browser close >/dev/null 2>&1 || true
        if agent-browser state load "$SESSION_FILE" 2>/dev/null; then
            # Verify still logged in
            agent-browser open "${BASE_URL}/account/" 2>/dev/null || true
            agent-browser wait --load networkidle 2>/dev/null || true
            local logged_in
            logged_in=$(agent-browser eval 'document.documentElement.classList.contains("aa-logged-in")' 2>/dev/null | tr -d '"' || true)
            if [[ "$logged_in" == "true" ]]; then
                log "Browser session restored"
                return 0
            fi
        fi
    fi
    browser_login
}

# curl-based login (for search only)
curl_login() {
    local secret
    if command -v secrets &> /dev/null; then
        secret=$(secrets lease annas_archive_key --ttl 15m --raw 2>/dev/null)
    fi
    [[ -z "$secret" ]] && { error "Failed to lease annas_archive_key from agent-secrets"; return 1; }
    log "Logging in via curl..."
    curl -s -c "$COOKIE_FILE" -b "$COOKIE_FILE" -L -X POST \
        -d "key=${secret}" "${BASE_URL}/account/" > /dev/null
    log "Login successful"
}

check_curl_login() {
    [[ -f "$COOKIE_FILE" ]] && curl -s -o /dev/null -w '%{http_code}' -b "$COOKIE_FILE" "${BASE_URL}/account/" | grep -q "200"
}

# --- Search ---
search_books() {
    local query="$1"
    local format_filter="${2:-}"

    log "Searching: $query"
    [[ -n "$format_filter" ]] && log "Format filter: $format_filter"

    local html=$(curl -sL -m 20 -b "$COOKIE_FILE" "${BASE_URL}/search?q=$(echo "$query" | sed 's/ /+/g')")

    if ! echo "$html" | grep -q '/md5/'; then
        warn "Anna's Archive search returned no md5 links from $BASE_URL (bot-shielded or flapping). Trying Libgen..."
        search_libgen "$query" "$format_filter"
        echo ""
        echo "Usage: aa-book download <md5> [output_dir] [--keep-local]"
        return 0
    fi

    echo "$html" | python3 -c "
import sys, re
from html import unescape

html = sys.stdin.read()
format_filter = '$format_filter'.lower()

pattern = r'href=\"/md5/([a-f0-9]{32})\"[^>]*>([^<]+)</a>.*?(\d+(?:\.\d+)?\s*[KMG]?B).*?(pdf|epub|mobi|djvu|azw3)'
matches = re.findall(pattern, html, re.IGNORECASE | re.DOTALL)

seen = set()
results = []
for md5, title, size, fmt in matches:
    if md5 in seen: continue
    seen.add(md5)
    title = unescape(title.strip())[:60]
    fmt = fmt.lower()
    if format_filter and fmt != format_filter: continue
    color = '\033[32m' if fmt == 'pdf' else '\033[33m'
    results.append((md5, title, size, fmt, f'{color}{fmt}\033[0m'))

results.sort(key=lambda x: (0 if x[3] == 'pdf' else 1, x[3]))
for md5, title, size, fmt, disp in results[:15]:
    print(f'{md5}  {disp:12} {size:>8}  {title}')
" 2>/dev/null || {
        echo "$html" | grep -oP 'href="/md5/[a-f0-9]{32}"' | \
            sed 's/href="\/md5\///; s/"$//' | head -10 | sort -u
    }

    echo ""
    echo "Usage: aa-book download <md5> [output_dir] [--keep-local]"
    echo "No results? Mirrors flap (transient 502s) and Cloudflare-shielded ones blank curl search."
    echo "Retry after 'aa-book mirrors', or use the agent-browser fallback in the aa-book skill."
}

# Libgen shares md5s with Anna's Archive, and its mirrors answer plain curl
# when AA's are bot-shielded. Any md5 printed here feeds 'aa-book download'
# unchanged. Verified 2026-09-10 (Rebuilding Milo via libgen.li).
LIBGEN_MIRRORS="https://libgen.li https://libgen.vg"

search_libgen() {
    local query="$1"
    local format_filter="${2:-}"
    local q mirror html
    q=$(echo "$query" | sed 's/ /+/g')
    for mirror in $LIBGEN_MIRRORS; do
        html=$(curl -sL --connect-timeout 5 -m 25 -A "Mozilla/5.0" \
            "${mirror}/index.php?req=${q}&columns%5B%5D=t&res=25" 2>/dev/null) || html=""
        echo "$html" | grep -q '/md5/' && break
        html=""
    done
    if [[ -z "$html" ]]; then
        echo "  (libgen mirrors returned nothing either)"
        return 1
    fi
    log "Libgen results via $mirror (same md5s work with 'aa-book download')"
    echo "$html" | python3 -c "
import sys, re
from html import unescape
html = sys.stdin.read()
format_filter = '$format_filter'.lower()
seen = set(); results = []
for row in re.findall(r'<tr[^>]*>(.*?)</tr>', html, re.S):
    m = re.search(r'/md5/([a-f0-9]{32})', row)
    if not m: continue
    md5 = m.group(1)
    if md5 in seen: continue
    seen.add(md5)
    cells = [re.sub(r'\s+', ' ', unescape(re.sub(r'<[^>]+>', ' ', c))).strip()
             for c in re.findall(r'<td[^>]*>(.*?)</td>', row, re.S)]
    if len(cells) < 8: continue
    # libgen.li columns: title, author, publisher, year, lang, pages, size, ext, ...
    t = re.search(r'<a[^>]*edition\.php[^>]*>(.*?)</a>', row, re.S)
    title = re.sub(r'\s+', ' ', unescape(re.sub(r'<[^>]+>', ' ', t.group(1)))).strip()[:60] if t else cells[0][:60]
    author, size, fmt = cells[1][:30], cells[6], cells[7].lower()
    if format_filter and fmt != format_filter: continue
    color = '\033[32m' if fmt == 'pdf' else '\033[33m'
    results.append((md5, title, author, size, fmt, f'{color}{fmt}\033[0m'))
results.sort(key=lambda x: (0 if x[4] == 'pdf' else 1, x[4]))
for md5, title, author, size, fmt, disp in results[:15]:
    print(f'{md5}  {disp:12} {size:>8}  {title}  [{author}]')
"
}

# --- Download ---
# Uses agent-browser to navigate the fast_download?no_redirect=1 page
# and extract the CDN URL, then downloads with curl and optionally SCPs to NAS.
download_book() {
    local keep_local=0
    local args=()
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --keep-local) keep_local=1 ;;
            *) args+=("$1") ;;
        esac
        shift
    done

    local md5="${args[0]}"
    local output_dir="${args[1]:-$LOCAL_STAGING}"
    local max_retries=3

    if [[ -z "$md5" ]]; then
        error "Usage: aa-book download <md5> [output_dir] [--keep-local]"
        return 1
    fi

    status "Downloading md5: $md5"

    # Track daily downloads (25/day limit)
    local today=$(date +%Y-%m-%d)
    local count_file="${CONFIG_DIR}/download_count_${today}.txt"
    local count=$(cat "$count_file" 2>/dev/null || echo 0)

    if [[ $count -ge 25 ]]; then
        error "Daily download limit reached (25/day). Try tomorrow."
        return 1
    fi

    # Ensure browser is authenticated
    ensure_browser_auth

    # Try each fast partner server via no_redirect page
    local download_url=""
    for server in 0 1 2 3 4 5; do
        status "Trying Fast Partner Server #$((server + 1))..."
        agent-browser open "${BASE_URL}/fast_download/${md5}/0/${server}?no_redirect=1" 2>/dev/null
        agent-browser wait --load networkidle 2>/dev/null

        # Extract CDN URL — look for links to partner CDN domains
        download_url=$(agent-browser eval 'Array.from(document.querySelectorAll("a[href]")).map(a=>a.href).find(h=>/\/(d[0-9]|get)\//.test(h)||/\.(pdf|epub|mobi)$/.test(h))||""' 2>/dev/null | tr -d '"')

        if [[ -n "$download_url" && "$download_url" != "" ]]; then
            log "Got CDN URL from server #$((server + 1))"
            break
        fi
        sleep 1
    done

    if [[ -z "$download_url" ]]; then
        error "Could not get download URL from any server"
        return 1
    fi

    # Derive filename
    local decoded_filename=$(python3 -c "import urllib.parse,sys; print(urllib.parse.unquote(sys.argv[1].split('/')[-1]))" "$download_url")
    local extension="${decoded_filename##*.}"
    local slug=$(echo "$decoded_filename" | sed 's/ -- .*//; s/[^a-zA-Z0-9 ]//g; s/  */ /g' | cut -c1-80 | sed 's/ /-/g' | tr '[:upper:]' '[:lower:]')
    local filename="${slug}.${extension}"
    local filepath="${output_dir}/${filename}"

    log "Downloading: $decoded_filename"
    log "Saving as: $filename"

    for attempt in $(seq 1 $max_retries); do
        if curl -L -o "$filepath" "$download_url" --connect-timeout 15 --max-time 300 --progress-bar 2>&1; then
            if [[ -f "$filepath" && $(stat -f%z "$filepath" 2>/dev/null || echo 0) -gt 1000 ]]; then
                echo $((count + 1)) > "$count_file"
                log "Download count today: $((count + 1))/25"
                break
            fi
        fi
        warn "Download attempt $attempt failed, retrying..."
        rm -f "$filepath" 2>/dev/null
        sleep 3
    done

    if [[ ! -f "$filepath" ]]; then
        error "Download failed after $max_retries attempts"
        return 1
    fi

    # docs-brain ingests .pdf, .md and .txt. An epub becomes a Markdown sibling
    # (stdlib, seconds, keeps chapter headings and printed page markers); the
    # original stays as the archive copy. mobi/azw3 still need Calibre.
    local ingest_path=""
    if [[ "$extension" == "epub" ]]; then
        local md_path="${filepath%.*}.md"
        status "Converting epub to Markdown..."
        if python3 -I "${SCRIPT_DIR}/epub2md" "$filepath" "$md_path"; then
            ingest_path="$md_path"
        else
            warn "epub2md failed; trying Calibre"
        fi
    fi
    if [[ -z "$ingest_path" && "$extension" =~ ^(epub|mobi|azw3)$ ]] && command -v ebook-convert &> /dev/null; then
        local pdf_path="${filepath%.*}.pdf"
        status "Converting $extension to PDF with Calibre..."
        local rc=0
        timeout 180 ebook-convert "$filepath" "$pdf_path" --pdf-page-numbers > "${CONFIG_DIR}/convert.log" 2>&1 || rc=$?
        if [[ $rc -eq 0 && -s "$pdf_path" ]]; then
            ingest_path="$pdf_path"
        elif [[ $rc -eq 124 ]]; then
            warn "Calibre hung for 180s (seen as a stuck macOS syspolicyd check at dyld start); keeping $extension"
        else
            warn "Calibre failed (exit $rc, see ${CONFIG_DIR}/convert.log); keeping $extension"
        fi
    fi
    [[ -z "$ingest_path" && "$extension" =~ ^(pdf|md|txt)$ ]] && ingest_path="$filepath"
    [[ -n "$ingest_path" ]] && log "Ingest-ready: $ingest_path"

    if [[ "$keep_local" -eq 1 ]]; then
        echo "${ingest_path:-$filepath}"
        return 0
    fi

    # Transfer to NAS (graceful — queue for retry if unreachable).
    # scp -O: the NAS has no SFTP subsystem, so default scp gets "Connection closed".
    local year=$(date +%Y)
    local nas_dir="${NAS_BOOKS_DIR}/${year}"
    local deferred_queue="${CONFIG_DIR}/deferred-transfers.txt"
    status "Transferring to NAS: ${NAS_HOST}:${nas_dir}/"
    if ssh -o ConnectTimeout=5 -o BatchMode=yes "$NAS_HOST" "mkdir -p '${nas_dir}'" 2>/dev/null && \
       scp -O -o ConnectTimeout=10 "$filepath" "${NAS_HOST}:${nas_dir}/$(basename "$filepath")" 2>/dev/null; then
        log "Stored on NAS: ${nas_dir}/$(basename "$filepath")"
        # The archive copy is on the NAS; the ingest-ready file stays local for joelclaw docs add.
        [[ "$filepath" != "$ingest_path" ]] && rm -f "$filepath" 2>/dev/null
    else
        warn "NAS unreachable — file kept at $filepath"
        warn "Queued for deferred transfer"
        echo "$(date -Iseconds)|${filepath}|${nas_dir}/$(basename "$filepath")" >> "$deferred_queue"
    fi

    echo "${ingest_path:-$filepath}"
}

# --- Status ---
check_nas_health() {
    if [[ -z "$NAS_HOST" || -z "$NAS_BOOKS_DIR" ]]; then
        error "NAS storage is not configured"
        echo "Set JOELCLAW_NAS_HOST and JOELCLAW_NAS_BOOKS_DIR in the environment or ~/.config/system-bus.env"
        return 1
    fi

    if ssh -o ConnectTimeout=5 -o BatchMode=yes "$NAS_HOST" \
        "test -d '${NAS_BOOKS_DIR}' && test -w '${NAS_BOOKS_DIR}'" 2>/dev/null; then
        echo "✅ NAS storage writable: ${NAS_HOST}:${NAS_BOOKS_DIR}"
        return 0
    fi

    error "NAS storage unavailable or not writable: ${NAS_HOST}:${NAS_BOOKS_DIR}"
    return 1
}

check_status() {
    local pid_file="${CONFIG_DIR}/current_job.pid"
    local health_failed=0

    if [[ -f "$pid_file" ]]; then
        local pid=$(cat "$pid_file")
        if ps -p "$pid" > /dev/null 2>&1; then
            echo "🔄 Job running (PID: $pid)"
            echo ""
            echo "Recent progress:"
            tail -10 "$PROGRESS_LOG"
        else
            echo "✅ Job completed"
            echo ""
            tail -20 "$PROGRESS_LOG" | grep -E '(STATUS|Complete|Error|complete)'
            rm "$pid_file"
        fi
    else
        echo "No active job"
        [[ -f "$PROGRESS_LOG" ]] && echo "Last log: tail -f $PROGRESS_LOG"
    fi

    local today=$(date +%Y-%m-%d)
    local count=$(cat "${CONFIG_DIR}/download_count_${today}.txt" 2>/dev/null || echo 0)
    echo ""
    echo "📊 Downloads today: $count/25"
    echo ""
    check_nas_health || health_failed=1
    return "$health_failed"
}

# --- Sync deferred transfers ---
sync_deferred() {
    local deferred_queue="${CONFIG_DIR}/deferred-transfers.txt"
    if [[ ! -f "$deferred_queue" || ! -s "$deferred_queue" ]]; then
        echo "✅ No deferred transfers"
        return 0
    fi

    # Check the configured destination, not merely whether the host answers SSH.
    if ! check_nas_health; then
        error "NAS still unreachable"
        echo "Pending transfers:"
        cat "$deferred_queue" | while IFS='|' read -r ts src dst; do
            echo "  $(basename "$src") (queued $ts)"
        done
        return 1
    fi

    local remaining=""
    while IFS='|' read -r ts src dst; do
        [[ -z "$src" ]] && continue
        if [[ ! -f "$src" ]]; then
            warn "Source gone: $src (skipping)"
            continue
        fi
        local nas_dir
        nas_dir="$(dirname "$dst")"
        # dst is already the absolute NAS path recorded at queue time.
        ssh -o ConnectTimeout=5 "$NAS_HOST" "mkdir -p '${nas_dir}'" 2>/dev/null || true
        if scp -O -o ConnectTimeout=10 "$src" "${NAS_HOST}:${dst}" 2>/dev/null; then
            log "Synced: $(basename "$src")"
            rm -f "$src" 2>/dev/null
        else
            warn "Still failed: $(basename "$src")"
            remaining+="${ts}|${src}|${dst}\n"
        fi
    done < "$deferred_queue"

    if [[ -n "$remaining" ]]; then
        echo -e "$remaining" > "$deferred_queue"
    else
        rm -f "$deferred_queue"
        log "All deferred transfers complete"
    fi
}

# --- Help ---
show_help() {
    echo "aa-book — Anna's Archive → NAS book pipeline"
    echo ""
    echo "Commands:"
    echo "  search <query> [format]     Search (format: pdf, epub, mobi)"
    echo "  download <md5> [dir] [--keep-local]"
    echo "                              Download → convert → optional SCP to NAS"
    echo "  sync                        Retry deferred NAS transfers"
    echo "  status                      Check job, daily quota & NAS storage"
    echo "  login                       Force browser re-login"
    echo ""
    echo "Examples:"
    echo "  aa-book search 'designing data intensive' pdf"
    echo "  aa-book download eaa2571df81dc9fa85cafaa89db7e81a"
    echo "  aa-book download eaa2571df81dc9fa85cafaa89db7e81a /tmp/books --keep-local"
    echo "  aa-book status"
    echo ""
    echo "Auth: agent-secrets (annas_archive_key) + agent-browser"
    echo "Storage: ${NAS_HOST}:${NAS_BOOKS_DIR}/YYYY/"
    echo "Daily limit: 25 fast downloads"
}

# --- Main ---
case "${1:-}" in
    search)
        shift
        check_curl_login || curl_login
        if [[ "$#" -ge 2 && "${!#}" =~ ^(pdf|epub|mobi)$ ]]; then
            format="${!#}"
            query="${*:1:$#-1}"
            search_books "$query" "$format"
        else
            search_books "$*"
        fi
        ;;
    download)
        shift
        download_book "$@"
        ;;
    sync) sync_deferred ;;
    status) check_status ;;
    login) browser_login ;;
    mirrors)
        log "Discovering mirrors..."
        all=$(discover_mirrors)
        echo "$all" > "$MIRRORS_CACHE"
        for m in $all; do
            status=$(probe_mirror "$m")
            case "$status" in
                ok)       echo -e "  ${GREEN}✓${NC} $m (ok: curl search works)" ;;
                shielded) echo -e "  ${YELLOW}~${NC} $m (shielded: bot check blanks curl search; browser download still works)" ;;
                parked)   echo -e "  ${RED}✗${NC} $m (parked domain)" ;;
                *)        echo -e "  ${RED}✗${NC} $m ($status)" ;;
            esac
        done
        rm -f "$ACTIVE_MIRROR_CACHE"
        BASE_URL=$(AA_FORCE_PROBE=1 resolve_base_url) || { error "No usable mirror. Search falls back to Libgen; downloads need a live AA mirror."; exit 1; }
        log "Active: $BASE_URL"
        log "Cache: $MIRRORS_CACHE"
        ;;
    help|--help|-h) show_help ;;
    *) show_help ;;
esac
